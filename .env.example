# Copy to .env and fill in. Never commit .env.

# This server's IP address on the imaging network (PXE clients connect to it)
SERVER_IP=10.10.0.5
# Network address and mask of the imaging network (for proxyDHCP)
PXE_SUBNET=10.10.0.0
PXE_NETMASK=255.255.255.0
# Optional: only answer PXE on this interface
PXE_INTERFACE=

POSTGRES_PASSWORD=change-me

# Where the admin UI listens. Keep it off the public network; publish via Pangolin.
ADMIN_BIND=127.0.0.1:8080
# Optional: restrict admins (Pangolin's Remote-Email header)
ADMIN_DOMAIN=mckinnonsc.vic.edu.au
ADMIN_EMAILS=

# Optional: PIN technicians must enter to start a task from a machine's console
AGENT_PIN=
# What machines boot into when nothing is queued for them: local or imaging
DEFAULT_BOOT=local

# Local development only: pretend to be this user when there are no auth headers
DEV_USER=
