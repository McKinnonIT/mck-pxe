# Copy to .env and fill in. Never commit .env.

# This server's IP address on the imaging network (PXE clients connect to it)
SERVER_IP=10.10.0.5
# Network address and mask of the imaging network (for proxyDHCP)
PXE_SUBNET=10.10.0.0
PXE_NETMASK=255.255.255.0
# Optional: only answer PXE on this interface
PXE_INTERFACE=

POSTGRES_PASSWORD=change-me

# Docker network of the newt container Pangolin talks to. The admin UI joins
# it and is reachable there as http://mck-pxe:8080 (set that as the Pangolin
# resource target). Find it with: docker ps --format '{{.Names}}  {{.Networks}}' | grep -i newt
PANGOLIN_NETWORK=

# What machines boot into when nothing is queued for them: local or imaging
DEFAULT_BOOT=local

# Password for the "admin" account created on first start. Leave empty to have
# one generated: it's printed in the API log and saved to
# data/system/initial-admin-password.txt until you change it.
INITIAL_ADMIN_PASSWORD=
