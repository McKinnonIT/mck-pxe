#!ipxe
# BIOS clients land here after undionly.kpxe. Ask the server for a per-machine
# script (machines with a queued task boot straight into imaging).
chain http://${SERVER_IP}/api/boot/ipxe/${netX/mac}?platform=${platform} || goto fallback

:fallback
menu mck-pxe (server unreachable - static menu)
item imaging mck-pxe imaging environment
item safe    mck-pxe imaging environment (safe graphics)
item text    mck-pxe imaging environment (text mode)
item local   Boot from local disk
choose --default local --timeout 5000 target && goto ${target}

:local
exit

:imaging
kernel http://${SERVER_IP}/boot/vmlinuz initrd=initrd.img boot=live ethdevice-timeout=60 fetch=http://${SERVER_IP}/boot/filesystem.squashfs mckpxe.server=http://${SERVER_IP} systemd.hostname=mckpxe md_mod.start_ro=1 quiet loglevel=3
initrd http://${SERVER_IP}/boot/initrd.img
boot

:safe
kernel http://${SERVER_IP}/boot/vmlinuz initrd=initrd.img boot=live ethdevice-timeout=60 fetch=http://${SERVER_IP}/boot/filesystem.squashfs mckpxe.server=http://${SERVER_IP} systemd.hostname=mckpxe md_mod.start_ro=1 quiet loglevel=3 nomodeset
initrd http://${SERVER_IP}/boot/initrd.img
boot

:text
kernel http://${SERVER_IP}/boot/vmlinuz initrd=initrd.img boot=live ethdevice-timeout=60 fetch=http://${SERVER_IP}/boot/filesystem.squashfs mckpxe.server=http://${SERVER_IP} systemd.hostname=mckpxe md_mod.start_ro=1 quiet loglevel=3 mckpxe.ui=text
initrd http://${SERVER_IP}/boot/initrd.img
boot
