def ci_path(root, rel, create=False):
    """Resolve a Windows path case-insensitively under a ntfs-3g mount."""
    cur = root
    for comp in rel.strip("/").split("/"):
        match = None
        if os.path.isdir(cur):
            for name in os.listdir(cur):
                if name.lower() == comp.lower():
                    match = name
                    break
        cur = os.path.join(cur, match or comp)
        if match is None and not create:
            return None
    return cur


def mount(node, target, fstype=None, ro=False):
    os.makedirs(target, exist_ok=True)
    if fstype == "ntfs":
        opts = "ro" if ro else "rw,remove_hiberfile"
        sh(["ntfs-3g", "-o", opts, node, target])
    else:
        sh(["mount"] + (["-o", "ro"] if ro else []) + [node, target])


def umount(target):
    sh(["sync"], check=False)
    sh(["umount", target], check=False)


def find_windows_partition(disk):
    for p in partitions(disk):
        if p["fstype"] != "ntfs":
            continue
        try:
            mount(p["path"], "/mnt/probe", "ntfs", ro=True)
        except RuntimeError:
            continue
        try:
            if ci_path("/mnt/probe", "Windows/System32"):
                return p
        finally:
            umount("/mnt/probe")
    return None


# --------------------------------------------------------------------------- windows customisation

SETUPCOMPLETE_MARK = "rem mck-pxe drivers"


def windows_customise(win, task, r):
    """Inject drivers and unattend.xml into an offline Windows install mounted at win."""
    drivers = task.get("drivers") or []
    if drivers:
        root = ci_path(win, "Drivers/mck-pxe", create=True)
        os.makedirs(root, exist_ok=True)
        for d in drivers:
            r.log(f"Injecting drivers: {d['name']} ({d['count']} packages)")
            dest = os.path.join(root, d["slug"])
            os.makedirs(dest, exist_ok=True)
            sh(f"{ref_cmd(d)} | tar -x -C {q(dest)}")

        # 1) Windows searches DevicePath during first-boot device install
        hive = ci_path(win, "Windows/System32/config/SOFTWARE")
        key = "\\Microsoft\\Windows\\CurrentVersion"
        current = sh(["hivexget", hive, key, "DevicePath"], check=False).strip() or "%SystemRoot%\\inf"
        if "mck-pxe" not in current:
            value = current + ";%SystemDrive%\\Drivers\\mck-pxe"
            data = (value + "\0").encode("utf-16-le")
            reg = ("Windows Registry Editor Version 5.00\n\n"
                   f"[HKEY_LOCAL_MACHINE\\SOFTWARE{key}]\n"
                   f"\"DevicePath\"=hex(2):{','.join(f'{b:02x}' for b in data)}\n")
            with open("/tmp/devicepath.reg", "w") as f:
                f.write(reg)
            sh(["hivexregedit", "--merge", hive, "--prefix", "HKEY_LOCAL_MACHINE\\SOFTWARE", "/tmp/devicepath.reg"])

        # 2) pnputil after setup catches anything PnP didn't pick up
        scripts = ci_path(win, "Windows/Setup/Scripts", create=True)
        os.makedirs(scripts, exist_ok=True)
        cmd = ci_path(win, "Windows/Setup/Scripts/SetupComplete.cmd", create=True)
        existing = open(cmd, encoding="utf-8", errors="replace").read() if os.path.exists(cmd) else ""
        if SETUPCOMPLETE_MARK not in existing:
            block = (f"\r\n{SETUPCOMPLETE_MARK}\r\n"
                     "pnputil /add-driver \"%SystemDrive%\\Drivers\\mck-pxe\\*.inf\" /subdirs /install"
                     " >> \"%SystemRoot%\\Temp\\mck-pxe-drivers.log\" 2>&1\r\n")
            with open(cmd, "w", encoding="utf-8", newline="") as f:
                f.write(existing + block)

    if has_resource(task, "unattend"):
        r.log("Writing unattend.xml")
        panther = ci_path(win, "Windows/Panther", create=True)
        os.makedirs(panther, exist_ok=True)
        sh(f"{resource_cmd(task, 'unattend')} > {q(os.path.join(panther, 'unattend.xml'))}")


def customise_disk(disk, task, r):
    if not task.get("drivers") and not has_resource(task, "unattend"):
        return
    p = find_windows_partition(disk)
    if not p:
        r.log("No Windows partition found; skipping driver injection")
        return
    mount(p["path"], "/mnt/win", "ntfs")
    try:
        windows_customise("/mnt/win", task, r)
    finally:
        umount("/mnt/win")


# --------------------------------------------------------------------------- tasks

# A task either talks to the server (URLs) or to the USB data store (task["local_dir"]).

def upload_cmd(task, name):
    """Shell command that stores stdin as one image file."""
    if task.get("local_dir"):
        return f"cat > {q(os.path.join(task['local_dir'], name))}"
    url = task["upload_url"] + "/" + name
    return f"curl -sSf -H 'Expect:' -H 'Content-Type: application/octet-stream' -T - {q(url)}"


def source_cmd(task, name):
    """Shell command that writes one image file to stdout."""
    if task.get("local_dir"):
        return f"cat {q(os.path.join(task['local_dir'], name))}"
    return f"curl -sSf {q(task['files_url'] + name)}"


def has_resource(task, name):
    return bool(task.get(f"{name}_path") or task.get(f"{name}_url"))


def resource_cmd(task, name):
    """Shell command that writes the unattend or bcd resource to stdout."""
    if task.get(f"{name}_path"):
        return f"cat {q(task[name + '_path'])}"
    return f"curl -sSf {q(task[name + '_url'])}"


def ref_cmd(ref):
    """Shell command that writes a driver pack tar to stdout (from the server or the stick)."""
    return f"cat {q(ref['path'])}" if ref.get("path") else f"curl -sSf {q(ref['url'])}"


def capture_block(task, r):
    disk = task["disk"]
    table = json.loads(sh(["sfdisk", "-J", disk]))["partitiontable"]
    sector = int(read(f"/sys/block/{os.path.basename(disk)}/queue/logical_block_size", "512"))
    parts = partitions(disk)
    in_table = len(table.get("partitions", []))
    r.log(f"{disk}: {table.get('label', '?').upper()} table, {in_table} partitions in table, "
          f"{len(parts)} visible to the kernel")
    for p in parts:
        r.log(f"  {p['path']}  {human(int(p['size']))}  {p['fstype'] or 'no filesystem'}  {p['label'] or ''}")
    if not parts:
        if in_table:
            raise RuntimeError(f"The partition table lists {in_table} partitions, but Linux can't see them. "
                               "Reboot into mck-pxe and try again.")
        raise RuntimeError(f"{disk} has no partitions, so there's nothing to capture.")
    if any(p["fstype"] == "BitLocker" for p in parts):
        raise RuntimeError("BitLocker is enabled on this disk. Decrypt it before capturing.")

    steps = Steps(r, [1] + [max(int(p["size"]) >> 20, 1) for p in parts])
    steps.next("Saving partition table")
    sh(f"dd if={q(disk)} bs=1M count=1 status=none | {upload_cmd(task, 'head.bin')}")
    sh(f"sfdisk -d {q(disk)} | {upload_cmd(task, 'table.sfdisk')}")

    meta_parts = []
    for p in parts:
        n, fs = int(p["partn"]), p["fstype"] or ""
        entry = {"number": n, "fstype": fs, "size": int(p["size"]), "uuid": p["uuid"], "label": p["label"]}
        steps.next(f"Capturing partition {n} ({fs or 'raw'})")
        if fs == "swap":
            entry["tool"] = "swap"
        elif fs in PARTCLONE:
            entry["tool"], entry["file"] = PARTCLONE[fs], f"p{n}.pc.zst"
            run_pipeline(f"{PARTCLONE[fs]} -c -s {q(p['path'])} -o - | zstd -T0 -3 -q"
                         f" | {upload_cmd(task, entry['file'])} 2>/dev/null", steps)
        else:
            entry["tool"], entry["file"] = "raw", f"p{n}.raw.zst"
            run_pipeline(f"pv -n -s {p['size']} {q(p['path'])} | zstd -T0 -3 -q"
                         f" | {upload_cmd(task, entry['file'])} 2>/dev/null", steps)
        meta_parts.append(entry)

    end = max((int(x["start"]) + int(x["size"]) for x in table.get("partitions", [])), default=0)
    os_family = "windows" if find_windows_partition(disk) else (
        "linux" if any(p["fstype"] in ("ext4", "xfs", "btrfs") for p in parts) else "other")
    return {
        "os_family": os_family,
        "meta": {
            "table": table["label"], "sector_size": sector,
            "source_bytes": int(sh(["blockdev", "--getsize64", disk]).strip()),
            "required_bytes": (end + 34) * sector,
            "first_lba": min((int(x["start"]) for x in table.get("partitions", [])), default=2048),
            "partitions": meta_parts,
        },
    }


def deploy_block(task, r):
    disk, image = task["disk"], task["image"]
    meta = image["meta"]
    size = int(sh(["blockdev", "--getsize64", disk]).strip())
    sector = int(read(f"/sys/block/{os.path.basename(disk)}/queue/logical_block_size", "512"))
    if size < meta["required_bytes"]:
        raise RuntimeError(f"Disk too small: needs {meta['required_bytes'] >> 30} GiB, has {size >> 30} GiB")
    if sector != meta["sector_size"]:
        raise RuntimeError(f"Sector size mismatch: image {meta['sector_size']}, disk {sector}")

    parts = meta["partitions"]
    steps = Steps(r, [1] + [max(p["size"] >> 20, 1) for p in parts] + [1])
    steps.next("Writing partition table")
    sh(["wipefs", "-a", disk])
    dump = sh(source_cmd(task, "table.sfdisk"))
    # Drop disk-specific lines so the table fits disks of a different size
    dump = "\n".join(ln for ln in dump.splitlines() if not ln.startswith(("device:", "last-lba:")))
    p = subprocess.run(["sfdisk", "--no-reread", "--wipe", "always", disk], input=dump, text=True, capture_output=True)
    if p.returncode != 0:
        raise RuntimeError("sfdisk: " + p.stderr.strip())
    if meta["table"] == "dos":
        # MBR boot code and the gap before the first partition (e.g. GRUB core.img)
        sh(f"{source_cmd(task, 'head.bin')} > /tmp/head.bin")
        sh(["dd", "if=/tmp/head.bin", f"of={disk}", "bs=440", "count=1", "conv=notrunc", "status=none"])
        gap = min(meta.get("first_lba", 2048), (1 << 20) // sector) - 1
        if gap > 0:
            sh(["dd", "if=/tmp/head.bin", f"of={disk}", f"bs={sector}", "skip=1", "seek=1",
                f"count={gap}", "conv=notrunc", "status=none"])
    settle()

    for p in parts:
        node = part_node(disk, p["number"])
        steps.next(f"Restoring partition {p['number']} ({p['fstype'] or 'raw'})")
        if p["tool"] == "swap":
            sh(["mkswap", "-U", p["uuid"], "-L", p.get("label") or "", node], check=False)
        elif p["tool"] == "raw":
            run_pipeline(f"{source_cmd(task, p['file'])} | zstd -dc | pv -n -s {p['size']} | "
                         f"dd of={q(node)} bs=4M iflag=fullblock conv=fsync status=none", steps)
        else:
            run_pipeline(f"{source_cmd(task, p['file'])} | zstd -dc | {p['tool']} -r -s - -o {q(node)}", steps)

    steps.next("Customising Windows")
    if image["os_family"] == "windows":
        customise_disk(disk, task, r)
    sh(["sync"])
    return {}


def capture_wim(task, r):
    disk = task["disk"]
    p = find_windows_partition(disk)
    if not p:
        raise RuntimeError("No Windows partition found (is Fast Startup / hibernation disabled?)")
    steps = Steps(r, [1])
    steps.next(f"Capturing Windows from {p['path']}")
    name = task["params"].get("name") or "Windows"
    run_pipeline(f"wimlib-imagex capture {q(p['path'])} - {q(name)} --pipable --compress=LZX "
                 f"| {upload_cmd(task, 'image.wim')}", steps)
    return {"os_family": "windows", "meta": {"pipable": True, "indexes": [{"index": 1, "name": name}]}}


def deploy_wim(task, r):
    if not os.path.isdir("/sys/firmware/efi"):
        raise RuntimeError("WIM deployment needs the machine booted in UEFI mode")
    if not has_resource(task, "bcd"):
        raise RuntimeError("No Windows boot template (BCD). Upload one on the server's Settings page"
                           " (and copy the image to the stick again for offline use).")
    disk, image = task["disk"], task["image"]
    index = int(task["params"].get("wim_index") or 1)
    steps = Steps(r, [1, 40, 2])

    steps.next("Partitioning (GPT: EFI, MSR, Windows)")
    sh(["wipefs", "-a", disk])
    sh(["sgdisk", "-Z", disk], check=False)
    sh(["sgdisk", "-n1:0:+260M", "-t1:ef00", "-c1:EFI system partition",
        "-n2:0:+16M", "-t2:0c01", "-c2:Microsoft reserved partition",
        "-n3:0:0", "-t3:0700", "-c3:Windows", disk])
    settle()
    esp, win = part_node(disk, 1), part_node(disk, 3)
    sh(["mkfs.vfat", "-F", "32", "-n", "SYSTEM", esp])
    sh(["mkntfs", "-Q", "-L", "Windows", win])

    steps.next(f"Applying {image['name']} (index {index})")
    run_pipeline(f"{source_cmd(task, 'image.wim')} | wimlib-imagex apply - {index} {q(win)}", steps)

    steps.next("Installing boot files and drivers")
    mount(win, "/mnt/win", "ntfs")
    mount(esp, "/mnt/esp")
    try:
        src = ci_path("/mnt/win", "Windows/Boot/EFI")
        if not src:
            raise RuntimeError("Image has no Windows/Boot/EFI directory")
        boot = "/mnt/esp/EFI/Microsoft/Boot"
        os.makedirs(boot, exist_ok=True)
        os.makedirs("/mnt/esp/EFI/Boot", exist_ok=True)
        sh(["cp", "-r", src + "/.", boot])
        fonts = ci_path("/mnt/win", "Windows/Boot/Fonts")
        if fonts:
            sh(["cp", "-r", fonts, boot + "/Fonts"])
        sh(["cp", os.path.join(boot, "bootmgfw.efi"), "/mnt/esp/EFI/Boot/bootx64.efi"])
        sh(f"{resource_cmd(task, 'bcd')} > {q(boot + '/BCD')}")
        windows_customise("/mnt/win", task, r)
    finally:
        umount("/mnt/esp")
        umount("/mnt/win")
    sh(["efibootmgr", "-c", "-d", disk, "-p", "1", "-L", "Windows Boot Manager",
        "-l", "\\EFI\\Microsoft\\Boot\\bootmgfw.efi"], check=False)
    steps.update(100)
    return {}


HANDLERS = {
    ("capture", "block"): capture_block, ("deploy", "block"): deploy_block,
    ("capture", "wim"): capture_wim, ("deploy", "wim"): deploy_wim,
}


class LocalReporter:
    """Progress for jobs that aren't server tasks: console and web UI only."""

    pending = []

    def log(self, line):
        print(line, flush=True)
        job_log(line)

    def send(self, progress, message, force=False):
        pass


def run_task(task):
    """Run a server task, or a local USB one (task["local"], finished by task["on_done"]).
    Returns (ok, message)."""
    local = task.get("local", False)
    r = LocalReporter() if local else Reporter(task["id"])
    label = "USB" if local else f"Task #{task['id']}"
    print(f"\n=== {label}: {task['type']} {task['kind']} on {task['disk']} ===\n", flush=True)
    result, ok, message = {}, True, "Completed"
    try:
        result = HANDLERS[(task["type"], task["kind"])](task, r) or {}
    except Cancelled:
        ok, message = False, "cancelled"
    except Exception as e:  # report every failure back to the admin UI
        ok, message = False, str(e)
    if local:
        try:
            task["on_done"](ok, result)
        except Exception as e:
            ok, message = False, f"{message}; then couldn't save to the stick: {e}"
    print(f"\n{'OK' if ok else 'FAILED'}: {message}", flush=True)
    if not local:
        try:
            api("POST", f"/tasks/{task['id']}/complete", {"ok": ok, "message": message, "log": r.pending, **result})
        except Exception as e:
            print(f"Could not report result: {api_error(e)}")
    return ok, message


# --------------------------------------------------------------------------- actions
#
# Everything a technician can do at the machine. No prompts here: the web UI
# and the text menu collect the answers, then call these.

def human(n):
    for unit in ("B", "KB", "MB", "GB", "TB"):
        if n < 1000:
            return f"{n:.0f} {unit}"
        n /= 1000
    return f"{n:.0f} PB"


def require_store():
    root = store_root()
    if not root:
        raise RuntimeError("There's no USB image storage. Prepare the stick first.")
    return root


def find_store_image(root, image_dir):
    image = next((i for i in store_images(root) if i["dir"] == image_dir), None)
    if not image:
        raise RuntimeError("That image isn't on the USB storage any more")
    return image


def queue_server_task(hw, body):
    """Ask the server to queue a deploy or capture for this machine. The poll loop runs it."""
    api("POST", "/tasks", {"mac": hw["mac"], **body})


def exec_usb_capture(hw, name, kind, disk):
    root = require_store()
    folder = os.path.join(root, "images", f"{slug(name)}-{time.strftime('%Y%m%d-%H%M%S')}")
    os.makedirs(folder)

    def done(ok, result):
        if not ok:
            shutil.rmtree(folder, ignore_errors=True)
            return
        write_json(os.path.join(folder, "image.json"), {
            "name": name, "description": "", "kind": kind, "os_family": result.get("os_family", "other"),
            "meta": result.get("meta", {}), "unattend": "", "source": f"{hw['manufacturer']} {hw['model']}".strip(),
            "created_at": time.strftime("%Y-%m-%dT%H:%M:%S"), "server_image_id": None,
        })

    job_log(f"USB storage free: {human(shutil.disk_usage(root).free)}")
    return run_task({"id": "usb", "local": True, "type": "capture", "kind": kind, "disk": disk,
                     "params": {"name": name}, "local_dir": folder, "on_done": done})


def exec_usb_deploy(hw, image_dir, disk, wim_index=None, inject=True):
    root = require_store()
    image = find_store_image(root, image_dir)
    bcd = os.path.join(root, "BCD")
    if image["kind"] == "wim" and not os.path.exists(bcd):
        raise RuntimeError("There's no Windows boot template on the stick. Copy a WIM image from the server "
                           "once while online (it brings the template with it), then try again.")
    drivers = store_drivers(image, hw) if inject and image["os_family"] == "windows" else []
    task = {"id": "usb", "local": True, "type": "deploy", "kind": image["kind"], "disk": disk,
            "params": {"wim_index": wim_index}, "local_dir": image["dir"],
            "image": {k: image[k] for k in ("name", "kind", "os_family", "meta")},
            "drivers": drivers, "bcd_path": bcd if os.path.exists(bcd) else None,
            "on_done": lambda ok, result: None}
    if image.get("unattend"):
        with open("/tmp/mckpxe-unattend.xml", "w") as f:
            f.write(image["unattend"])
        task["unattend_path"] = "/tmp/mckpxe-unattend.xml"
    return run_task(task)


def exec_usb_copy(hw, image_id, name):
    """Copy a server image onto the stick, with this model's drivers."""
    root = require_store()
    m = api("GET", f"/images/{image_id}/manifest?mac={hw['mac']}", timeout=60)
    existing = next((i for i in store_images(root) if i.get("server_image_id") == image_id), None)
    folder = existing["dir"] if existing else \
        os.path.join(root, "images", f"{slug(name)}-server{image_id}")
    os.makedirs(folder, exist_ok=True)
    todo = [f for f in m["files"] if not (os.path.exists(os.path.join(folder, f["name"]))
                                           and os.path.getsize(os.path.join(folder, f["name"])) == f["size"])]
    need, free = sum(f["size"] for f in todo), shutil.disk_usage(root).free
    if need > free:
        raise RuntimeError(f"Not enough space on the USB storage: this needs {human(need)}, "
                           f"and {human(free)} is free.")
    steps = Steps(LocalReporter(), [max(f["size"] >> 20, 1) for f in todo] + [1])
    for f in todo:
        steps.next(f"Copying {f['name']}")
        part = os.path.join(folder, f".{f['name']}.part")
        run_pipeline(f"curl -sSf {q(f['url'])} | pv -n -s {f['size']} > {q(part)}", steps)
        os.replace(part, os.path.join(folder, f["name"]))
    steps.next(f"Copying drivers for the {hw['model']}")
    if m["drivers"]:
        drv_dir = os.path.join(folder, "drivers", model_key(hw))
        os.makedirs(drv_dir, exist_ok=True)
        index = []
        for d in m["drivers"]:
            file = f"{d['slug']}.tar"
            sh(f"curl -sSf {q(d['url'])} > {q(os.path.join(drv_dir, file))}")
            index.append({"name": d["name"], "slug": d["slug"], "count": d["count"], "file": file})
        write_json(os.path.join(drv_dir, "index.json"), index)
    if m.get("bcd_url"):
        sh(f"curl -sSf {q(m['bcd_url'])} > {q(os.path.join(root, 'BCD'))}")
    write_json(os.path.join(folder, "image.json"), {
        **{k: m["image"][k] for k in ("name", "description", "kind", "os_family", "meta")},
        "unattend": m.get("unattend") or "", "source": "server", "server_image_id": image_id,
        "created_at": time.strftime("%Y-%m-%dT%H:%M:%S"),
    })
    steps.update(100)
    sh(["sync"], check=False)
    return True, f"Copied to the USB stick, with {len(m['drivers'])} driver packs for the {hw['model']}"


def exec_usb_upload(hw, image_dir, pin=None):
    """Add an image from the stick to the server's library."""
    root = require_store()
    image = find_store_image(root, image_dir)
    body = {"mac": hw["mac"], **{k: image.get(k, "") for k in ("name", "description", "kind", "os_family", "meta",
                                                                "unattend")}}
    if pin:
        body["pin"] = pin
    image_id = api("POST", "/images", body)["id"]
    files = image_files(image)
    sizes = [os.path.getsize(os.path.join(image["dir"], f)) for f in files]
    try:
        steps = Steps(LocalReporter(), [max(s >> 20, 1) for s in sizes])
        for f, size in zip(files, sizes, strict=True):
            steps.next(f"Uploading {f}")
            url = f"{API}/images/{image_id}/upload/{f}"
            run_pipeline(f"pv -n -s {size} {q(os.path.join(image['dir'], f))} | curl -sSf -H 'Expect:' "
                         f"-H 'Content-Type: application/octet-stream' -T - {q(url)}", steps)
        api("POST", f"/images/{image_id}/complete", {"ok": True})
    except BaseException as e:
        try:
            api("POST", f"/images/{image_id}/complete", {"ok": False, "message": str(e) or "cancelled"})
        except Exception:
            pass
        raise
    write_json(os.path.join(image["dir"], "image.json"),
               {k: v for k, v in {**image, "server_image_id": image_id}.items() if k != "dir"})
    return True, "The image is now in the server's library"


def usb_summary(hw):
    """USB storage state for the web UI."""
    root = store_root()
    if not root:
        try:
            plan = usb_create_plan()
            return {"ready": False, "can_create": True, "size": plan["bytes"], "stick": plan["stick"]}
        except RuntimeError as e:
            return {"ready": False, "can_create": False, "reason": str(e)}
    images = []
    for i in store_images(root):
        size = sum(os.path.getsize(os.path.join(i["dir"], f)) for f in image_files(i))
        images.append({
            "dir": i["dir"], "name": i["name"], "kind": i["kind"], "os_family": i["os_family"],
            "indexes": i.get("meta", {}).get("indexes", []), "size": size,
            "drivers": sum(d["count"] for d in store_drivers(i, hw)),
            "on_server": bool(i.get("server_image_id")), "created_at": i.get("created_at", ""),
        })
    return {"ready": True, "free": shutil.disk_usage(root).free, "has_bcd": os.path.exists(os.path.join(root, "BCD")),
            "images": images}


# --------------------------------------------------------------------------- shared state

STATE = {"hw": None, "refresh": True, "info": {}, "online": False, "status": "Starting",
         "mode": "text", "switch_to_text": False, "kiosk": None}
WAKE = threading.Event()


def ensure_hw():
    if STATE["refresh"] or STATE["hw"] is None:
        # Re-register with the new details, but stay "online" in the meantime
        STATE["hw"], STATE["refresh"], STATE["registered"] = collect_hardware(), False, False
    return STATE["hw"]


def connect():
    """Register with the server if needed. Returns True when online."""
    hw = ensure_hw()
    try:
        if not STATE["online"] or not STATE.get("registered"):
            STATE["info"] = api("POST", "/register", hw)
            STATE["online"] = STATE["registered"] = True
        return True
    except Exception as e:
        STATE["online"], STATE["status"] = False, f"Server unreachable: {api_error(e)}"
        return False


# --------------------------------------------------------------------------- text menu (backup UI)

def clear():
    sys.stdout.write("\033[2J\033[H")
    sys.stdout.flush()


def wait_key(seconds):
    fd = sys.stdin.fileno()
    try:
        old = termios.tcgetattr(fd)
    except termios.error:
        time.sleep(seconds or 0)
        return None
    try:
        tty.setcbreak(fd)
        ready, _, _ = select.select([sys.stdin], [], [], seconds)
        return sys.stdin.read(1) if ready else None
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, old)


def whiptail(*args):
    p = subprocess.run(["whiptail", "--title", "mck-pxe", *args], stderr=subprocess.PIPE, text=True)
    return p.stderr.strip() if p.returncode == 0 else None


def msg(text, height="10"):
    whiptail("--msgbox", text, height, "64")


def pick_disk(hw):
    disks = hw["disks"]
    if not disks:
        msg("No disks found.")
        return None
    items = []
    for d in disks:
        items += [d["path"], f"{human(d['size'])} {d['model']} {d['transport']}"]
    return whiptail("--menu", "Select disk", "16", "70", "6", *items)


def ask_pin(info):
    """The console PIN if the server needs one, "" if not, None if cancelled."""
    if not info.get("pin_required"):
        return ""
    return whiptail("--passwordbox", "Console PIN", "8", "40")


def ask_image(images, title):
    items = []
    for n, i in enumerate(images):
        items += [str(n + 1), f"{i['name']} [{i['kind']}, {i['os_family']}]"[:56]]
    choice = whiptail("--menu", title, "20", "70", "10", *items)
    return images[int(choice) - 1] if choice else None


def ask_wim_index(meta):
    indexes = meta.get("indexes", [])
    if len(indexes) <= 1:
        return indexes[0]["index"] if indexes else 1
    items = []
    for ix in indexes:
        items += [str(ix["index"]), ix["name"][:50]]
    idx = whiptail("--menu", "Select Windows edition", "18", "70", "8", *items)
    return int(idx) if idx else None


def ask_capture(hw):
    name = whiptail("--inputbox", "Image name", "8", "60", f"{hw['model']} {time.strftime('%Y-%m-%d')}")
    if not name:
        return None
    kind = whiptail("--menu", "Capture type", "12", "70", "2",
                    "block", "Whole disk, block level (fastest, same hardware)",
                    "wim", "Windows WIM (hardware independent, sysprep first)")
    return (name, kind) if kind else None


def confirm_erase(disk):
    text = f"ALL DATA ON {disk} WILL BE ERASED.\n\nContinue?"
    return whiptail("--defaultno", "--yesno", text, "10", "50") is not None


def tui_store():
    """USB storage for a save, offering to create it on the boot stick. None if unavailable."""
    root = store_root()
    if root:
        return root
    plan = usb_create_plan()
    if whiptail("--yesno", f"Create a {human(plan['bytes'])} partition for images in the free space on the boot "
                f"stick ({plan['stick']})?\n\nThe stick stays bootable.", "11", "60") is None:
        return None
    create_data_partition(plan)
    return store_root()


def tui_run(title, fn, after=None):
    """Run a job in the foreground with console output, then handle reboot/power off."""
    clear()
    with JOB_LOCK:
        ok, message = run_job(title, fn)
    print(f"\n{'OK' if ok else 'FAILED'}: {message}", flush=True)
    if ok and after in ("reboot", "poweroff"):
        print(f"{after.capitalize()} in 10 seconds (press any key to cancel)...", flush=True)
        if wait_key(10) is None:
            sh(["systemctl", after], check=False)
    else:
        print("Press any key to continue.", flush=True)
        wait_key(None)


def tui_server_task(hw, info, choice):
    body = {"type": choice}
    pin = ask_pin(info)
    if pin is None:
        return
    body["pin"] = pin
    if choice == "deploy":
        images = api("GET", "/images")
        if not images:
            msg("No images are ready on the server.")
            return
        image = ask_image(images, "Select image")
        if not image:
            return
        body["image_id"] = image["id"]
        if image["kind"] == "wim":
            body["wim_index"] = ask_wim_index(image["meta"])
            if body["wim_index"] is None:
                return
        if image["os_family"] == "windows":
            inject = whiptail("--yesno", "Inject matching drivers automatically?", "8", "50") is not None
            body["drivers"] = "auto" if inject else "none"
    else:
        answer = ask_capture(hw)
        if not answer:
            return
        body.update({"name": answer[0], "kind": answer[1]})
    disk = pick_disk(hw)
    if not disk or (choice == "deploy" and not confirm_erase(disk)):
        return
    body["disk"] = disk
    try:
        queue_server_task(hw, body)
    except Exception as e:
        msg(f"Server refused: {api_error(e)}")


def tui_usb_capture(hw):
    if not tui_store():
        return
    answer = ask_capture(hw)
    disk = answer and pick_disk(hw)
    if not disk:
        return
    tui_run("Capture to USB", lambda: exec_usb_capture(hw, answer[0], answer[1], disk))


def tui_usb_deploy(hw):
    root = store_root()
    images = store_images(root) if root else []
    if not images:
        msg("There are no images on the USB storage yet. Capture to USB, or copy an image from the server, first.")
        return
    image = ask_image(images, "Deploy from USB")
    if not image:
        return
    index = ask_wim_index(image["meta"]) if image["kind"] == "wim" else None
    if image["kind"] == "wim" and index is None:
        return
    inject = False
    if image["os_family"] == "windows":
        drivers = store_drivers(image, hw)
        if drivers:
            count = sum(d["count"] for d in drivers)
            inject = whiptail("--yesno", f"The stick has {count} drivers for the {hw['model']}. Inject them?",
                              "9", "60") is not None
        else:
            msg(f"No drivers for the {hw['model']} on the stick, so none will be injected. To add them, "
                "boot this model online and copy the image to the stick again.", "11")
    disk = pick_disk(hw)
    if not disk or not confirm_erase(disk):
        return
    tui_run(f"Deploy {image['name']} from USB",
            lambda: exec_usb_deploy(hw, image["dir"], disk, index, inject), after="reboot")


def tui_usb_copy(hw):
    images = api("GET", "/images")
    if not images:
        msg("No images are ready on the server.")
        return
    chosen = ask_image(images, "Copy to USB")
    if chosen and tui_store():
        tui_run(f"Copy {chosen['name']} to USB", lambda: exec_usb_copy(hw, chosen["id"], chosen["name"]))


def tui_usb_upload(hw, info):
    root = store_root()
    images = store_images(root) if root else []
    if not images:
        msg("There are no images on the USB storage.")
        return
    image = ask_image(images, "Upload to server")
    pin = image and ask_pin(info)
    if pin is None or not image:
        return
    tui_run(f"Upload {image['name']} to the server", lambda: exec_usb_upload(hw, image["dir"], pin))


def console_menu(hw, info, online):
    items = []
    if online:
        items += ["deploy", "Deploy an image from the server",
                  "capture", "Capture this machine to the server"]
    items += ["usb-deploy", "Deploy an image from the USB stick",
              "usb-capture", "Capture this machine to the USB stick"]
    if online:
        items += ["usb-copy", "Copy a server image to the USB stick",
                  "usb-upload", "Upload a USB image to the server"]
    items += ["shell", "Open a root shell", "reboot", "Reboot", "poweroff", "Power off"]
    title = f"{hw['manufacturer']} {hw['model']}  ({hw['mac']})" + ("" if online else "  [offline]")
    choice = whiptail("--menu", title, "20", "66", str(len(items) // 2), *items)
    if choice in ("reboot", "poweroff"):
        sh(["systemctl", choice], check=False)
        time.sleep(30)
    elif choice == "shell":
        clear()
        print("Type 'exit' to return to mck-pxe.\n")
        subprocess.run(["bash", "-l"], env={**os.environ, "MCKPXE_SHELL": "1"})
    elif choice in ("deploy", "capture"):
        tui_server_task(hw, info, choice)
    elif choice == "usb-deploy":
        tui_usb_deploy(hw)
    elif choice == "usb-capture":
        tui_usb_capture(hw)
    elif choice == "usb-copy":
        tui_usb_copy(hw)
    elif choice == "usb-upload":
        tui_usb_upload(hw, info)


def banner(hw, status):
    clear()
    print("mck-pxe imaging environment (text mode)\n" + "=" * 60)
    print(f"  Machine : {hw['manufacturer']} {hw['model']}")
    print(f"  Serial  : {hw['serial']}")
    print(f"  MAC/IP  : {hw['mac']}  {hw['ip']}")
    print(f"  Boot    : {hw['boot_mode'].upper()}  Secure Boot {'on' if hw['secure_boot'] else 'off'}")
    print(f"  Server  : {SERVER}")
    for d in hw["disks"]:
        print(f"  Disk    : {d['path']}  {human(d['size'])}  {d['model']}")
    print("=" * 60)
    print(f"\n  {status}\n\n  Press [M] for menu.", flush=True)


def tui_main():
    """The text menu: polls the server, runs tasks in the foreground."""
    STATE["mode"] = "text"
    while True:
        status = STATE["status"]
        if connect():
            try:
                task = api("GET", f"/next?mac={STATE['hw']['mac']}")
                if task:
                    tui_run(f"Server task #{task['id']}", lambda t=task: run_task(t),
                            after=task["params"].get("after", "reboot"))
                    STATE["refresh"] = True
                    continue
                status = "Waiting for a task from the server..."
            except Exception as e:
                STATE["online"], status = False, f"Server unreachable: {api_error(e)} (retrying)"
        banner(STATE["hw"], status)
        key = wait_key(POLL_SECONDS)
        if key and key.lower() == "m":
            try:
                # USB options work offline; server ones need registration
                console_menu(STATE["hw"], STATE["info"], online=STATE["online"])
            except Cancelled:
                pass
            except Exception as e:
                msg(f"Error: {api_error(e)}")
            STATE["refresh"] = True  # disks may have changed


# --------------------------------------------------------------------------- web UI
#
# A small local web app, shown full screen by Firefox in kiosk mode. It only
# listens on 127.0.0.1: anyone who can reach it can wipe the machine.

UI_DIR = os.environ.get("MCKPXE_UI_DIR", "/usr/local/share/mck-agent/ui")
UI_PORT = int(os.environ.get("MCKPXE_UI_PORT", "8090"))
UI_HOSTS = {f"127.0.0.1:{UI_PORT}", f"localhost:{UI_PORT}"}
STATIC_TYPES = {".html": "text/html", ".js": "text/javascript", ".css": "text/css", ".svg": "image/svg+xml"}


class Busy(Exception):
    pass


def start_job(title, fn, after=None):
    """Run fn as the current job in the background, for the web UI."""
    if not JOB_LOCK.acquire(blocking=False):
        raise Busy("Something is already running")

    def work():
        try:
            run_job(title, fn, after)
        finally:
            STATE["refresh"] = True
            JOB_LOCK.release()
            WAKE.set()

    threading.Thread(target=work, daemon=True).start()


def web_state():
    hw = STATE["hw"] or {}
    return {
        "server": SERVER, "online": STATE["online"], "status": STATE["status"],
        "pin_required": bool(STATE["info"].get("pin_required")),
        "hw": {k: v for k, v in hw.items() if k != "hardware_ids"},
        "job": {k: v for k, v in JOB.items() if k != "cancel"},
        "busy": JOB_LOCK.locked(),
    }


def web_action(data):
    """Start one action from the web UI. Returns a message, or raises."""
    hw, action = ensure_hw(), data.get("action")
    if action == "server-task":
        if JOB_LOCK.locked():
            raise Busy("Something is already running")
        body = {k: data.get(k) for k in ("type", "image_id", "wim_index", "drivers", "name", "kind", "disk", "pin",
                                         "after")}
        queue_server_task(hw, {k: v for k, v in body.items() if v is not None})
        WAKE.set()
        return "Queued on the server. It starts in a moment."
    if action == "usb-capture":
        start_job(f"Capture {data['name']} to USB",
                  lambda: exec_usb_capture(hw, data["name"], data["kind"], data["disk"]))
    elif action == "usb-deploy":
        start_job("Deploy from USB", lambda: exec_usb_deploy(hw, data["dir"], data["disk"], data.get("wim_index"),
                                                             bool(data.get("inject", True))),
                  after=data.get("after") or "reboot")
    elif action == "usb-copy":
        start_job(f"Copy {data['name']} to USB", lambda: exec_usb_copy(hw, int(data["image_id"]), data["name"]))
    elif action == "usb-upload":
        start_job("Upload to the server", lambda: exec_usb_upload(hw, data["dir"], data.get("pin")))
    elif action == "usb-prepare":
        if JOB_LOCK.locked():
            raise Busy("Something is already running")
        create_data_partition()
        store_root()
        return "USB storage is ready"
    else:
        raise ValueError(f"Unknown action: {action}")
    return "Started"


class UIHandler(BaseHTTPRequestHandler):
    def log_message(self, *args):
        pass

    def reply(self, code, data=None, body=None, ctype="application/json"):
        payload = body if body is not None else json.dumps(data).encode()
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(payload)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(payload)

    def allowed(self):
        # Blocks DNS rebinding: only pages loaded from this machine may call the API
        if self.headers.get("Host") not in UI_HOSTS:
            self.reply(403, {"detail": "Forbidden"})
            return False
        return True

    def do_GET(self):
        if not self.allowed():
            return
        path = urllib.parse.urlparse(self.path).path
        try:
            if path == "/api/state":
                return self.reply(200, web_state())
            if path == "/api/usb":
                return self.reply(200, usb_summary(ensure_hw()))
            if path == "/api/server-images":
                return self.reply(200, api("GET", "/images") if STATE["online"] else [])
        except Exception as e:
            return self.reply(500, {"detail": api_error(e)})
        name = "index.html" if path == "/" else path.lstrip("/")
        full = os.path.realpath(os.path.join(UI_DIR, name))
        if not full.startswith(os.path.realpath(UI_DIR) + os.sep) or not os.path.isfile(full):
            return self.reply(404, {"detail": "Not found"})
        with open(full, "rb") as f:
            self.reply(200, body=f.read(), ctype=STATIC_TYPES.get(os.path.splitext(full)[1], "text/plain"))

    def do_POST(self):
        if not self.allowed():
            return
        path = urllib.parse.urlparse(self.path).path
        try:
            data = json.loads(self.rfile.read(int(self.headers.get("Content-Length") or 0)) or b"{}")
            if path == "/api/action":
                return self.reply(200, {"message": web_action(data)})
            if path == "/api/job/cancel":
                JOB["cancel"] = True
            elif path == "/api/job/dismiss":
                if not JOB_LOCK.locked():
                    JOB.update(state="idle", after=None, after_at=None)
            elif path == "/api/after/cancel":
                JOB.update(after=None, after_at=None)
            elif path == "/api/power":
                if data.get("action") in ("reboot", "poweroff"):
                    sh(["systemctl", data["action"]], check=False)
            elif path == "/api/refresh":
                STATE["refresh"] = True
                WAKE.set()
            elif path == "/api/ui/text":
                if JOB_LOCK.locked():
                    raise Busy("Wait for the current job to finish first")
                STATE["switch_to_text"] = True
                if STATE["kiosk"]:
                    STATE["kiosk"].terminate()
            else:
                return self.reply(404, {"detail": "Not found"})
            return self.reply(200, {"ok": True})
        except Busy as e:
            return self.reply(409, {"detail": str(e)})
        except (KeyError, ValueError) as e:
            return self.reply(400, {"detail": f"Bad request: {e}"})
        except Exception as e:  # shown in the web UI
            return self.reply(500, {"detail": api_error(e)})


def poll_loop():
    """Web mode: keep registered, run server tasks, handle reboot countdowns."""
    while not STATE["switch_to_text"]:
        if JOB["after"] and JOB["after_at"] and time.time() >= JOB["after_at"]:
            action = JOB["after"]
            JOB.update(after=None, after_at=None)
            sh(["systemctl", action], check=False)
        if connect() and JOB_LOCK.acquire(blocking=False):
            try:
                task = api("GET", f"/next?mac={STATE['hw']['mac']}")
                STATE["status"] = "Waiting for a task from the server"
                if task:
                    run_job(f"Server task #{task['id']}: {task['type']} ({task['kind']})",
                            lambda t=task: run_task(t), after=task["params"].get("after", "reboot"))
                    STATE["refresh"] = True
            except Exception as e:
                STATE["online"], STATE["status"] = False, f"Server unreachable: {api_error(e)}"
            finally:
                JOB_LOCK.release()
        WAKE.wait(1 if JOB["after"] else POLL_SECONDS)
        WAKE.clear()


KIOSK_PREFS = """
user_pref("browser.shell.checkDefaultBrowser", false);
user_pref("browser.aboutwelcome.enabled", false);
user_pref("browser.startup.homepage_override.mstone", "ignore");
user_pref("browser.sessionstore.resume_from_crash", false);
user_pref("datareporting.policy.dataSubmissionEnabled", false);
user_pref("toolkit.telemetry.reportingpolicy.firstRun", false);
user_pref("app.update.auto", false);
user_pref("browser.translations.enable", false);
user_pref("signon.rememberSignons", false);
"""


def kiosk_available():
    if (cmdline_arg("mckpxe.ui") or "web") == "text":
        return False, "text mode was chosen at boot"
    if not glob.glob("/dev/dri/card*"):
        return False, "no graphics device"
    for tool in ("cage", "firefox-esr", "seatd-launch"):
        if not shutil.which(tool):
            return False, f"{tool} isn't installed"
    return True, ""


def run_kiosk():
    """Show the web UI full screen until it exits. Returns when it's time for the text menu."""
    profile = "/tmp/mck-kiosk-profile"
    os.makedirs(profile, exist_ok=True)
    with open(os.path.join(profile, "user.js"), "w") as f:
        f.write(KIOSK_PREFS)
    runtime = "/run/user/0"
    os.makedirs(runtime, mode=0o700, exist_ok=True)
    env = {**os.environ, "XDG_RUNTIME_DIR": runtime, "HOME": "/root", "MOZ_ENABLE_WAYLAND": "1"}
    url = f"http://127.0.0.1:{UI_PORT}/"
    for _ in range(3):
        started = time.time()
        with open("/var/log/mck-kiosk.log", "a") as log:
            STATE["kiosk"] = subprocess.Popen(
                ["seatd-launch", "--", "cage", "-s", "--",
                 "firefox-esr", "--kiosk", "--no-remote", "--profile", profile, url],
                env=env, stdout=log, stderr=log)
            STATE["kiosk"].wait()
        STATE["kiosk"] = None
        if STATE["switch_to_text"] or time.time() - started < 20:
            return  # asked for text mode, or graphics failed straight away
        time.sleep(2)  # crashed after running a while: restart it


def web_main():
    STATE["mode"] = "web"
    ensure_hw()
    server = ThreadingHTTPServer(("127.0.0.1", UI_PORT), UIHandler)
    threading.Thread(target=server.serve_forever, daemon=True).start()
    threading.Thread(target=poll_loop, daemon=True).start()
    run_kiosk()
    # Hand over to the text menu (the web UI asked for it, or graphics didn't work)
    STATE["switch_to_text"] = True
    WAKE.set()
    with JOB_LOCK:  # let a running job finish first
        pass
    server.shutdown()
    clear()
    print("Switching to text mode (details: /var/log/mck-kiosk.log)", flush=True)
    time.sleep(2)


def main():
    if not SERVER:
        print("No mckpxe.server= on the kernel command line.")
        subprocess.run(["bash", "-l"])
        return
    ok, reason = kiosk_available()
    if ok:
        web_main()
    else:
        print(f"Starting text mode: {reason}", flush=True)
        time.sleep(1)
    tui_main()


if __name__ == "__main__":
    main()
