#!/usr/bin/env python3
"""mck-pxe imaging agent.

Runs on tty1 of the PXE boot environment. Registers the machine with the
server, runs queued capture/deploy tasks, and offers a console menu so a
technician at the machine can deploy or capture an image themselves.
"""
import glob
import json
import os
import re
import select
import shlex
import shutil
import subprocess
import sys
import termios
import threading
import time
import tty
import urllib.error
import urllib.parse
import urllib.request
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

POLL_SECONDS = 5


def cmdline_arg(name):
    try:
        for part in open("/proc/cmdline").read().split():
            if part.startswith(name + "="):
                return part.split("=", 1)[1]
    except OSError:
        pass
    return None


SERVER = (cmdline_arg("mckpxe.server") or os.environ.get("MCKPXE_SERVER", "")).rstrip("/")
API = SERVER + "/api/agent"


class Cancelled(Exception):
    pass


# --------------------------------------------------------------------------- server

def api(method, path, body=None, timeout=30):
    data = json.dumps(body).encode() if body is not None else None
    req = urllib.request.Request(API + path, data=data, method=method)
    req.add_header("Content-Type", "application/json")
    with urllib.request.urlopen(req, timeout=timeout) as resp:
        raw = resp.read()
        return json.loads(raw) if raw else None


def api_error(e):
    if isinstance(e, urllib.error.HTTPError):
        try:
            return json.loads(e.read()).get("detail", str(e))
        except Exception:
            return str(e)
    return str(e)


# --------------------------------------------------------------------------- shell helpers

def sh(cmd, check=True):
    """Run a command, return stdout. cmd may be a list or a bash string."""
    if isinstance(cmd, str):
        cmd = ["bash", "-o", "pipefail", "-c", cmd]
    p = subprocess.run(cmd, capture_output=True, text=True)
    if check and p.returncode != 0:
        raise RuntimeError(f"{' '.join(cmd)}: {p.stderr.strip() or p.stdout.strip()}")
    return p.stdout


def q(s):
    return shlex.quote(str(s))


def read(path, default=""):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return default


def settle():
    sh(["partprobe"], check=False)
    sh(["udevadm", "settle"], check=False)
    time.sleep(1)


# --------------------------------------------------------------------------- hardware

def primary_iface():
    try:
        routes = json.loads(sh(["ip", "-j", "route", "show", "default"]))
        if routes:
            return routes[0]["dev"]
    except Exception:
        pass
    for path in sorted(glob.glob("/sys/class/net/*")):
        name = os.path.basename(path)
        if name != "lo" and read(f"{path}/carrier") == "1":
            return name
    return None


def iface_ip(iface):
    try:
        info = json.loads(sh(["ip", "-j", "-4", "addr", "show", iface]))
        return info[0]["addr_info"][0]["local"]
    except Exception:
        return None


def disks_with_label(match):
    """Whole disks that have a filesystem whose label satisfies match(label)."""
    out = json.loads(sh(["lsblk", "-J", "-o", "PATH,LABEL,PKNAME,TYPE"], check=False) or '{"blockdevices": []}')
    found = set()

    def walk(devs):
        for d in devs:
            if match((d.get("label") or "").upper()):
                found.add(d["path"] if d["type"] == "disk" else f"/dev/{d['pkname']}")
            walk(d.get("children") or [])

    walk(out["blockdevices"])
    return found


def boot_media_disks():
    """The mck-pxe boot stick and MCKPXE-DATA drives, so a deploy can't wipe them."""
    return disks_with_label(lambda label: label.startswith("MCKPXE"))


# --------------------------------------------------------------------------- USB data store
#
# Images can live on an exFAT partition labelled MCKPXE-DATA: either added to
# the boot stick's free space by the agent, or any other drive with that label.
#   mck-pxe/images/<dir>/image.json        name, kind, os_family, meta, ...
#   mck-pxe/images/<dir>/<image files>      same names as on the server
#   mck-pxe/images/<dir>/drivers/<model>/   driver tars + index.json, per machine model
#   mck-pxe/BCD                             Windows boot template for WIM deploys

STORE_LABEL = "MCKPXE-DATA"
STORE_MOUNT = "/mnt/mckpxe-data"
MIN_DATA_BYTES = 1 << 30


def slug(text):
    return re.sub(r"[^A-Za-z0-9._-]+", "-", text).strip("-")[:60] or "image"


def model_key(hw):
    return slug(f"{hw.get('manufacturer', '')} {hw.get('model', '')}".strip()) or "unknown-model"


def plan_data_partition(mbr, total_sectors, sector=512):
    """Where a data partition fits in the boot stick's free space.

    mbr is the first 1024 bytes of the stick. Returns (slot, start, count) in
    sectors, or raises with a reason the technician can act on.
    """
    if len(mbr) < 1024 or mbr[510:512] != b"\x55\xaa":
        raise RuntimeError("The boot stick has no MBR partition table")
    if mbr[512:520] == b"EFI PART":
        raise RuntimeError("This stick was written from an older mck-pxe ISO. Download a new one from "
                           "Settings > Boot USB and write it to the stick again.")
    entries = []
    for i in range(4):
        e = mbr[446 + 16 * i: 462 + 16 * i]
        entries.append((e[4], int.from_bytes(e[8:12], "little"), int.from_bytes(e[12:16], "little")))
    if any(ptype == 0xEE for ptype, _, _ in entries):
        raise RuntimeError("The boot stick uses GPT. Write a new mck-pxe ISO to it from Settings > Boot USB.")
    free = [i for i, (ptype, start, count) in enumerate(entries) if ptype == 0 and start == 0 and count == 0]
    if not free:
        raise RuntimeError("The boot stick has no free partition slot")
    end = max((start + count for ptype, start, count in entries if count), default=0)
    align = (1 << 20) // sector
    start = -(-end // align) * align
    count = min(total_sectors - start, 0xFFFFFFFF)
    if count * sector < MIN_DATA_BYTES:
        raise RuntimeError("Not enough free space on the boot stick for images. Use a bigger stick "
                           "(32 GB or more), or plug in a drive labelled MCKPXE-DATA.")
    return free[0], start, count


def mbr_entry(start, count, ptype=0x07):
    """16-byte MBR partition entry. CHS fields set to 'use LBA'."""
    return bytes([0x00, 0xFE, 0xFF, 0xFF, ptype, 0xFE, 0xFF, 0xFF]) + start.to_bytes(4, "little") + \
        count.to_bytes(4, "little")


def usb_create_plan():
    """Where a data partition would go on the boot stick: {stick, slot, start, count, bytes}.
    Raises with the reason it can't be created."""
    sticks = disks_with_label(lambda label: label == "MCKPXE")
    if not sticks:
        raise RuntimeError("No drive labelled MCKPXE-DATA, and this machine wasn't booted from the "
                           "mck-pxe USB stick. Plug one in, or boot from the stick.")
    stick = sorted(sticks)[0]
    with open(stick, "rb") as f:
        mbr = f.read(1024)
    total = int(sh(["blockdev", "--getsz", stick]).strip())
    slot, start, count = plan_data_partition(mbr, total)
    return {"stick": stick, "slot": slot, "start": start, "count": count, "bytes": count * 512}


def create_data_partition(plan=None):
    """Add an exFAT MCKPXE-DATA partition in the boot stick's free space. Returns its node.
    Callers confirm with the technician first."""
    plan = plan or usb_create_plan()
    stick, slot, start, count = plan["stick"], plan["slot"], plan["start"], plan["count"]
    with open(stick, "r+b") as f:
        f.seek(446 + 16 * slot)
        f.write(mbr_entry(start, count))
        f.flush()
        os.fsync(f.fileno())
    # The stick may be in use, so add just the new partition instead of re-reading the table
    sh(["partx", "-a", "--nr", str(slot + 1), stick], check=False)
    settle()
    node = part_node(stick, slot + 1)
    sh(["mkfs.exfat", "-L", STORE_LABEL, node])
    return node


def store_root():
    """Mount the USB data store and return its mck-pxe folder, or None if there isn't one."""
    root = os.path.join(STORE_MOUNT, "mck-pxe")
    if not os.path.ismount(STORE_MOUNT):
        node = sh(["blkid", "-L", STORE_LABEL], check=False).strip()
        if not node:
            return None
        os.makedirs(STORE_MOUNT, exist_ok=True)
        sh(["mount", node, STORE_MOUNT])
    os.makedirs(os.path.join(root, "images"), exist_ok=True)
    return root


def store_images(root):
    images = []
    base = os.path.join(root, "images")
    for name in sorted(os.listdir(base)):
        try:
            with open(os.path.join(base, name, "image.json")) as f:
                images.append({**json.load(f), "dir": os.path.join(base, name)})
        except (OSError, ValueError):
            continue
    return images


def image_files(image):
    """The image's data files (everything except image.json and the drivers folder)."""
    return sorted(f for f in os.listdir(image["dir"])
                  if f != "image.json" and not f.startswith(".") and os.path.isfile(os.path.join(image["dir"], f)))


def store_drivers(image, hw):
    """Driver tars saved on the stick for this machine's model, in task["drivers"] form."""
    folder = os.path.join(image["dir"], "drivers", model_key(hw))
    try:
        with open(os.path.join(folder, "index.json")) as f:
            index = json.load(f)
    except (OSError, ValueError):
        return []
    return [{**d, "path": os.path.join(folder, d["file"])} for d in index
            if os.path.exists(os.path.join(folder, d["file"]))]


def write_json(path, data):
    tmp = path + ".tmp"
    with open(tmp, "w") as f:
        json.dump(data, f, indent=2)
    os.replace(tmp, path)
    sh(["sync"], check=False)


def list_disks():
    out = json.loads(sh(["lsblk", "-J", "-b", "-d", "-o", "NAME,PATH,SIZE,MODEL,SERIAL,TRAN,TYPE,RM,RO"]))
    boot_media = boot_media_disks()
    disks = []
    for d in out["blockdevices"]:
        if d["type"] != "disk" or d["ro"] in (True, "1") or d["name"].startswith(("zram", "loop", "ram")):
            continue
        if d["path"] in boot_media:
            continue
        disks.append({
            "path": d["path"], "size": int(d["size"] or 0), "model": (d.get("model") or "").strip(),
            "serial": (d.get("serial") or "").strip(), "transport": d.get("tran") or "",
            "removable": d["rm"] in (True, "1"),
        })
    return disks


def hardware_ids():
    """Device IDs in the same normalised form the server extracts from INF files."""
    ids = set()
    for dev in glob.glob("/sys/bus/pci/devices/*"):
        v, d = read(f"{dev}/vendor")[2:], read(f"{dev}/device")[2:]
        if v and d:
            ids.add(f"PCI\\VEN_{v}&DEV_{d}".upper())
    for dev in glob.glob("/sys/bus/usb/devices/*"):
        v, p = read(f"{dev}/idVendor"), read(f"{dev}/idProduct")
        if v and p:
            ids.add(f"USB\\VID_{v}&PID_{p}".upper())
    for codec in glob.glob("/proc/asound/card*/codec#*"):
        m = re.search(r"Vendor Id:\s*0x([0-9a-f]{4})([0-9a-f]{4})", read(codec), re.I)
        if m:
            ids.add(f"HDAUDIO\\VEN_{m.group(1)}&DEV_{m.group(2)}".upper())
    for dev in glob.glob("/sys/bus/acpi/devices/*"):
        hid = read(f"{dev}/hid")
        if hid and read(f"{dev}/status", "15") != "0":
            ids.add(f"ACPI\\{hid}".upper())
    return sorted(ids)


def collect_hardware():
    iface = primary_iface()

    def dmi(f):
        return read(f"/sys/class/dmi/id/{f}")

    mem_kb = int(re.search(r"MemTotal:\s+(\d+)", read("/proc/meminfo")).group(1))
    cpu = re.search(r"model name\s*:\s*(.+)", read("/proc/cpuinfo"))
    return {
        "mac": read(f"/sys/class/net/{iface}/address") if iface else "",
        "ip": iface_ip(iface) if iface else None,
        "manufacturer": dmi("sys_vendor"),
        "model": dmi("product_name"),
        "version": dmi("product_version"),
        "sku": dmi("product_sku"),
        "serial": dmi("product_serial"),
        "cpu": cpu.group(1).strip() if cpu else "",
        "ram_mb": mem_kb // 1024,
        "boot_mode": "uefi" if os.path.isdir("/sys/firmware/efi") else "bios",
        "secure_boot": "enabled" in sh(["mokutil", "--sb-state"], check=False).lower(),
        "disks": list_disks(),
        "hardware_ids": hardware_ids(),
    }


def partitions(disk):
    out = json.loads(sh(["lsblk", "-J", "-b", "-o", "PATH,PARTN,SIZE,FSTYPE,UUID,LABEL,TYPE", disk]))
    parts = out["blockdevices"][0].get("children") or []
    return [p for p in parts if p["type"] == "part"]


def part_node(disk, number):
    for p in partitions(disk):
        if int(p["partn"]) == int(number):
            return p["path"]
    raise RuntimeError(f"partition {number} not found on {disk}")


# --------------------------------------------------------------------------- jobs and progress
#
# One job (capture, deploy, copy, upload) runs at a time, whoever started it:
# the server, the web UI or the text menu. JOB is what the web UI shows.

JOB_LOCK = threading.Lock()
JOB = {"id": 0, "state": "idle", "title": "", "progress": 0.0, "message": "", "log": [],
       "after": None, "after_at": None, "cancel": False}


def job_start(title):
    JOB.update(id=JOB["id"] + 1, state="running", title=title, progress=0.0, message="Starting", log=[],
               after=None, after_at=None, cancel=False)


def job_log(line):
    JOB["log"] = (JOB["log"] + [line])[-300:]


def job_progress(progress, message):
    JOB["progress"], JOB["message"] = progress, message
    if JOB["cancel"]:
        raise Cancelled()


def job_finish(ok, message, after=None):
    JOB["state"], JOB["message"] = ("done" if ok else "failed"), message
    if ok:
        JOB["progress"] = 100.0
    if ok and after in ("reboot", "poweroff"):
        JOB["after"], JOB["after_at"] = after, time.time() + 15


def run_job(title, fn, after=None):
    """Run fn() as the current job; fn returns (ok, message) or raises. Hold JOB_LOCK first."""
    job_start(title)
    try:
        ok, message = fn()
    except Cancelled:
        ok, message = False, "Cancelled"
    except Exception as e:  # shown to the technician
        ok, message = False, str(e)
    job_finish(ok, message, after)
    return ok, message


class Reporter:
    def __init__(self, task_id):
        self.task_id = task_id
        self.last = 0
        self.pending = []

    def log(self, line):
        print(line, flush=True)
        job_log(line)
        self.pending.append(line)
        self.send(None, None, force=True)

    def send(self, progress, message, force=False):
        now = time.time()
        if not force and now - self.last < 1.5:
            return
        self.last = now
        body = {"progress": progress, "message": message, "log": self.pending}
        try:
            resp = api("POST", f"/tasks/{self.task_id}/progress", body)
            self.pending = []
        except Exception:
            return
        if resp and resp.get("cancelled"):
            raise Cancelled()


class Steps:
    """Maps progress within one step onto overall task progress by weight."""

    def __init__(self, reporter, weights):
        self.r = reporter
        self.total = float(sum(weights)) or 1.0
        self.weights = weights
        self.index = -1
        self.done = 0.0

    def next(self, label):
        if self.index >= 0:
            self.done += self.weights[self.index]
        self.index += 1
        self.label = label
        self.r.log(label)
        self.update(0)

    def update(self, pct, extra=""):
        overall = (self.done + self.weights[self.index] * pct / 100.0) / self.total * 100.0
        msg = f"{self.label} {pct:.0f}%" + (f" ({extra})" if extra else "")
        print(f"\r  {msg:<70}", end="", flush=True)
        job_progress(round(overall, 1), msg)
        self.r.send(round(overall, 1), msg)


PCT_PATTERNS = [
    re.compile(r"Completed:\s*([\d.]+)%(?:.*?([\d.]+\s*[KMGT]?i?B/min))?"),  # partclone
    re.compile(r"\((\d+)%\)"),                                         # wimlib
    re.compile(r"^(\d+)$"),                                            # pv -n
]


def run_pipeline(script, steps):
    """Run a bash pipeline whose stderr carries progress, feeding it to steps."""
    proc = subprocess.Popen(["bash", "-o", "pipefail", "-c", script],
                            stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)
    tail = []
    buf = b""
    try:
        while True:
            chunk = proc.stderr.read1(4096) if hasattr(proc.stderr, "read1") else proc.stderr.read(4096)
            if not chunk:
                break
            buf += chunk
            parts = re.split(rb"[\r\n]", buf)
            buf = parts.pop()
            for raw in parts:
                line = raw.decode(errors="replace").strip()
                if not line:
                    continue
                for pat in PCT_PATTERNS:
                    m = pat.search(line)
                    if m:
                        rate = m.group(2) if m.lastindex and m.lastindex >= 2 else ""
                        steps.update(min(float(m.group(1)), 100.0), rate)
                        break
                else:
                    tail = (tail + [line])[-15:]
    except Cancelled:
        proc.kill()
        proc.wait()
        raise
    rc = proc.wait()
    print()
    if rc != 0:
        raise RuntimeError("command failed:\n" + "\n".join(tail[-8:]))
    steps.update(100)


